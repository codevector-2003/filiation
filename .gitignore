# Go
/fil
/fil.exe
/dist/
*.test
*.out
vendor/

# Tooling
.golangci-cache/
coverage.out

# Filiation data — never commit a user's library
*.db
*.db-wal
*.db-shm
/data/
/papers/
/blobs/
.filiation/

# Secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Source art for the README banner and social preview (large; the composed
# docs/assets/banner.jpg and social-preview.png are what is committed).
docs/assets/*.jfif

# The Windows installer's build output
/desktop/installer/build/
/desktop/installer/Output/

# Local AI-assistant settings (permissions, preferences): per person, not shared
.claude/
CLAUDE.local.md

# Logs and scratch
*.log
*.tmp
/tmp/

# Browser profiles left by headless screenshot runs
.chrome-*/
